{
    "name": "talhakazmi/cms-renderer",
    "description": "Laravel Blog Renderer - Display blogs from Global CMS in your Laravel application",
    "keywords": ["laravel", "blog", "cms", "renderer", "global-cms", "blog-renderer"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Talha Kazmi",
            "email": "talha@techozon.com"
        }
    ],
    "homepage": "https://github.com/TalhaKazmi1/cms-renderer-laravel",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "TalhaKazmi\\CmsRenderer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TalhaKazmi\\CmsRenderer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TalhaKazmi\\CmsRenderer\\CmsRendererServiceProvider"
            ],
            "aliases": {
                "CmsRenderer": "TalhaKazmi\\CmsRenderer\\Facades\\CmsRenderer"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
